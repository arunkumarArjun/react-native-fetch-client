{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "react-native-fetch-client": ["./src/index.ts"],
      "react-native-fetch-client/mock": ["./src/mock.ts"],
      "react-native-fetch-client/offline": ["./src/offline/index.ts"]
    }
  },
  "include": ["src", "test"],
  "exclude": ["node_modules", "dist", "examples"]
}
