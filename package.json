{
  "name": "react-native-fetch-client",
  "version": "0.3.0",
  "description": "A lightweight, Fetch-native HTTP client for TypeScript, React Native, Expo, browsers, and Node.js",
  "author": "Arunkumar Arjunan",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "fetch",
    "http",
    "client",
    "react-native",
    "expo",
    "typescript",
    "browser",
    "node"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arunkumarArjun/react-native-fetch-client.git"
  },
  "homepage": "https://react-native-fetch-client.vercel.app/",
  "bugs": {
    "url": "https://github.com/arunkumarArjun/react-native-fetch-client/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/arunkumarArjun/react-native-fetch-client"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./mock": {
      "import": {
        "types": "./dist/mock.d.ts",
        "default": "./dist/mock.mjs"
      },
      "require": {
        "types": "./dist/mock.d.cts",
        "default": "./dist/mock.cjs"
      }
    },
    "./offline": {
      "import": {
        "types": "./dist/offline.d.ts",
        "default": "./dist/offline.mjs"
      },
      "require": {
        "types": "./dist/offline.d.cts",
        "default": "./dist/offline.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "react-native": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "mock": ["./dist/mock.d.ts"],
      "offline": ["./dist/offline.d.ts"]
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "format": "prettier --write src test",
    "format:check": "prettier --check src test",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "prepublishOnly": "npm run validate && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
